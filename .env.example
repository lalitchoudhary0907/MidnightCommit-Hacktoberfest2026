DOCDRIFT_REPO_PATH=./
DOCDRIFT_DOCS_GLOBS=**/*.md,**/*.rst
DOCDRIFT_CODE_GLOBS=**/*.py,**/*.yml,**/*.yaml
DOCDRIFT_EXCLUDE_DIRS=.git,.venv,node_modules,build,dist
DOCDRIFT_MAX_FILE_SIZE_KB=1024
DOCDRIFT_MIN_CONFIDENCE=0.7

# AI Settings
DOCDRIFT_AI_ENABLED=false
DOCDRIFT_OLLAMA_ENDPOINT=http://localhost:11434
DOCDRIFT_OLLAMA_MODEL=gemma4:e4b
DOCDRIFT_OLLAMA_TIMEOUT_SEC=120

DOCDRIFT_REPORT_DIR=./docdrift-reports